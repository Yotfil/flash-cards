{
  "name": "flash-cards",
  "version": "1.1.0",
  "scripts": {
    "ng": "ng",
    "build-info": "node scripts/generate-build-info.mjs",
    "postinstall": "npm run build-info",
    "prestart": "npm run build-info",
    "start": "ng serve",
    "prebuild": "npm run build-info",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.integration.json --noEmit",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:integration": "firebase emulators:exec --only firestore --project demo-cadence \"vitest run --config vitest.integration.config.ts\"",
    "emulators": "node scripts/emulators.mjs",
    "seed:allowlist": "node scripts/seed-allowlist.mjs",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@11.3.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.0.2",
    "@angular/compiler": "^22.0.2",
    "@angular/core": "^22.0.2",
    "@angular/forms": "^22.0.2",
    "@angular/platform-browser": "^22.0.2",
    "@angular/router": "^22.0.2",
    "@angular/service-worker": "^22.0.2",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.1",
    "firebase": "^12.15.0",
    "postcss": "^8.5.15",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.1",
    "ts-fsrs": "^5.4.1",
    "tslib": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@angular/build": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.2",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "angular-eslint": "22.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.34.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.60.1",
    "vitest": "^4.0.8"
  },
  "description": "Cadence, repetición espaciada"
}
